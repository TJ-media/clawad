{"nodes": [{"id": "docs_design_impression_verification_servetoken", "label": "serveToken (\uc11c\uba85\ub41c \ub2e8\uae30 \ub178\ucd9c \ud1a0\ud070)", "file_type": "concept", "source_file": "docs/design/impression-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc11c\ubc84\ub9cc \ube44\ubc00 \ud0a4\ub97c \uac16\uace0 \ud074\ub77c\uc774\uc5b8\ud2b8\ub294 \ubcf4\uad00\u00b7\uc81c\ucd9c\ub9cc \ud55c\ub2e4. \ubc1c\uae09 \uc2dc \uc138\uc158 userId\uc640 \uae30\uae30\ub97c \ud568\uaed8 \uc11c\uba85\ud574 \uc81c\ucd9c \uc2dc\uc810\uc758 \uc0ac\uc6a9\uc790 \ubc14\uafd4\uce58\uae30\ub97c TOKEN_USER_MISMATCH\ub85c \uc7a1\ub294\ub2e4."}, {"id": "docs_design_impression_verification_idempotency_key", "label": "\uc11c\ubc84 \uc0dd\uc131 \uba71\ub4f1 \ud0a4 SHA-256(tokenJti:machineId:sequence)", "file_type": "concept", "source_file": "docs/design/impression-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud074\ub77c\uc774\uc5b8\ud2b8\uac00 HMAC\uc774\ub098 \ube44\ubc00 \ud0a4\ub97c \uac16\uc9c0 \uc54a\uac8c \ud558\ub824\uba74 \uba71\ub4f1 \ud0a4\ub97c \uc11c\ubc84\uac00 \ub9cc\ub4e4\uc5b4\uc57c \ud55c\ub2e4. DB \uc81c\uc57d\uc740 UNIQUE(idempotencyKey) \ud558\ub098\uc774\uba70 \uc138 \uc694\uc18c \uc870\ud569\uc758 \uc720\ub2c8\ud06c\uc640 \ub4f1\uac00\ub2e4."}, {"id": "docs_design_impression_verification_server_validation_chain", "label": "\uc11c\ubc84 \uac80\uc99d 9\ub2e8\uacc4 (\uc11c\uba85\u00b7\ubc14\uc778\ub529\u00b7\uae30\uae30\u00b7\uba71\ub4f1\u00b7viewability\u00b7\ub3d9\uc2dc\ub178\ucd9c\u00b7\ucea0\ud398\uc778\u00b7\uc0c1\ud55c)", "file_type": "concept", "source_file": "docs/design/impression-verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ub178\ucd9c \uc778\uc815\uc740 \uc11c\ubc84 \uac80\uc99d \ud1b5\uacfc\u