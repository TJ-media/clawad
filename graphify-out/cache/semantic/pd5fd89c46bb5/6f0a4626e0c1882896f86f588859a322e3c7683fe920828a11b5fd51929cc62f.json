{"nodes": [{"id": "docs_legal_privacy_design_collection_allowlist", "label": "\uc218\uc9d1 \ud5c8\uc6a9\ubaa9\ub85d = \uc2e4\uc81c \uc804\uc1a1 8\ud544\ub4dc", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud5c8\uc6a9\ubaa9\ub85d\uc758 \ub2e8\uc77c \uae30\uc900\uc744 \uc2e4\uc81c \uc804\uc1a1 \uc2a4\ud0a4\ub9c8\ub85c \uc7a1\uc544 \ubb38\uc11c\uac00 \ucf54\ub4dc\ubcf4\ub2e4 \ub113\uc740 \ubc94\uc704\ub97c \uc120\uc5b8\ud558\uc9c0 \ubabb\ud558\uac8c \ud55c\ub2e4. campaignId\u00b7tokenJti\ub294 \ud074\ub77c\uc774\uc5b8\ud2b8\uac00 \ubcf4\ub0b4\uc9c0 \uc54a\uace0 \uc11c\ubc84\uac00 \ud1a0\ud070\uc5d0\uc11c \ucd94\ucd9c\ud55c\ub2e4."}, {"id": "docs_legal_privacy_design_render_started_field", "label": "renderStarted (\ud45c\uc2dc \uc2dc\uc791 \uc9c4\ub2e8 \uc2e0\ud638)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc120\ud0dd\uc801\u00b7\uc9c4\ub2e8 \uc804\uc6a9\uc774\uba70 startedAt \uc774\ud558\ub2e4. \ub178\ucd9c \uc778\uc815\u00b7\uacfc\uae08\u00b7\ub9ac\uc6cc\ub4dc \ud310\uc815\uc5d0 \uc4f0\uc9c0 \uc54a\uc544 \ud310\uc815 \uacbd\ub85c\uc640 \uad00\uce21 \uacbd\ub85c\ub97c \uc11e\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "docs_legal_privacy_design_structural_denylist", "label": "\uad6c\uc870\uc801 \uc218\uc9d1 \uae08\uc9c0 (denylist)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc815\ucc45\uc774 \uc544\ub2c8\ub77c \uad6c\uc870\ub85c \ucc28\ub2e8\ud55c\ub2e4 \u2014 clawad \ubcf8\uccb4(client/*)\uac00 \uc811\uadfc \uc790\uccb4\ub97c \ud558\uc9c0 \uc54a\ub3c4\ub85d \uad6c\ud604\ud558\uace0, \uae08\uc9c0 \ubb38\uc790\uc5f4 \uac80\uc0ac\ub85c \ud14c\uc2a4\ud2b8\uac00 \uac15\uc81c\ud55c\ub2e4."}, {"id": "docs_legal_privacy_design_local_only_processing", "label": "\ub2e8\ub9d0 \ub0b4\uc5d0\uc11c\ub9cc \ucc98\ub9ac\ud558\ub294 \ud56d\ubaa9 (\u00a71.8, CLAW-127)", "file_type": "rationale", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud3ec\ud06c\uac00 \ubb3c\ub824\uc900 \ud45c\uc2dc \uae30\ub2a5\uc774 \ud504\ub86c\ud504\ud2b8 \uccab \uc904\u00b7\ud2b8\ub79c\uc2a4\ud06c\ub9bd\ud2b8\u00b7\uacbd\ub85c\u00b7\ud504\ub85c\uc138\uc2a4 \uc815\ubcf4\ub97c \ub2e8\ub9d0 \uc548\uc5d0\uc11c \uc77d\ub294\ub2e4. \ucc28\ub2e8\ud558\uba74 \uc138\uc158 \ud45c\uc2dc \uc774\ub984\u00b7\ucee8\ud14d\uc2a4\ud2b8 \uac8c\uc774\uc9c0\u00b7\ud130\ubbf8\ub110 \uc774\ub3d9\uc744 \uc783\uc5b4 \uc624\ubc84\ub808\uc774\uc758 \uc81c\ud488 \uac00\uce58\uac00 \uc0ac\ub77c\uc9c4\ub2e4\uace0 \ud310\ub2e8\ud574 \ucc28\ub2e8 \ub300\uc2e0 \uace0\uc9c0\ub97c \ud0dd\ud588\ub2e4. \uac10\uc218\ud558\ub294 \uc704\ud5d8\uc740 '\uad11\uace0 \ud074\ub77c\uc774\uc5b8\ud2b8\uac00 \ud504\ub86c\ud504\ud2b8\ub97c \uc77d\ub294\ub2e4'\ub294 \uc778\uc2dd\uc774\uba70, \uc18c\uc2a4 \uacf5\uac1c\u00b7\uacbd\ub85c \ubd84\ub9ac\u00b7\uc804\uc1a1 \uc5c6\uc74c \uba85\uc2dc\ub85c \uc0c1\uc1c4\ud55c\ub2e4. 5\uac1c \uc720\uc9c0 \uc870\uac74 \uc911 \ud558\ub098\ub77c\ub3c4 \uae68\uc9c0\uba74 \uacb0\uc815\uc744 \uc7ac\uac80\ud1a0\ud55c\ub2e4."}, {"id": "docs_legal_privacy_design_statusline_quota_default_on", "label": "statusLine \ucffc\ud130 \uc218\uc9d1 \uae30\ubcf8 \ud65c\uc131 (CLAW-136)", "file_type": "rationale", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc2ac\ub86f\uc744 \ube44\uc6cc\ub3c4 \uc0ac\uc6a9\uc790\uac00 \uc9c1\uc811 \ucf1c\uc9c0 \uc54a\uc73c\uba74 \ucffc\ud130\uac00 \uc218\uc9d1\ub418\uc9c0 \uc54a\uc544 CLAW-134\uc758 \ubaa9\uc801\uc774 \ub2ec\uc131\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc870\uac74\uc740 \uc804\uc1a1 \uc5c6\uc74c\u00b7\ub0a8\uc758 \uc124\uc815 \ubbf8\ub36e\uc5b4\uc4f0\uae30\u00b7\ub044\uace0 \ub418\ub3cc\ub9b4 \uc218 \uc788\uc74c\u00b7\uadf8 \uc790\ub9ac\uc5d0 \uad11\uace0 \ubbf8\ub80c\ub354\ub2e4."}, {"id": "docs_legal_privacy_design_fork_access_audit", "label": "\ubd80\ub85d A \ud3ec\ud06c \ub370\uc774\ud130 \uc811\uadfc \uac10\uc0ac (CLAW-87)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'\uc811\uadfc\ud558\uc9c0 \uc54a\ub294\ub2e4'\ub294 \uc120\uc5b8\ub9cc\uc73c\ub85c\ub294 \ubd80\uc871\ud574 \ud3ec\ud06c \ucf54\ub4dc\uac00 \uc2e4\uc81c\ub85c \uc77d\ub294 \uac83\uc744 \uc804\uc218 \ud655\uc778\ud588\ub2e4. \uc571\uc744 \ucf1c\ub294 \uac83\ub9cc\uc73c\ub85c \ud6c5\uc774 \uc124\uce58\ub418\ubbc0\ub85c \uc7a0\uc7ac \uc704\ud5d8\uc774 \uc544\ub2c8\ub77c \ud604\uc7ac \ub3d9\uc791\uc774\ub2e4."}, {"id": "docs_legal_privacy_design_machine_id_pseudonym", "label": "\uac00\uba85 \uba38\uc2e0 ID \uaddc\uce59", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud558\ub4dc\uc6e8\uc5b4 \uc2dd\ubcc4\uc790\ub97c \uc4f0\uc9c0 \uc54a\uc73c\ubbc0\ub85c '\ub3d9\uc77c \uae30\uae30 \uc644\ubcbd \uc2dd\ubcc4'\uc774\ub098 '\ub3d9\uc77c \uc9c0\ubb38 \ub2e4\uacc4\uc815 \ud655\uc815 \ud0d0\uc9c0'\ub77c\uace0 \ud45c\ud604\ud558\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "docs_legal_privacy_design_ip_not_product_data", "label": "\uc811\uc18d IP\ub294 \uc81c\ud488 \ub370\uc774\ud130\uac00 \uc544\ub2c8\ub2e4 (\u00a76.6)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc774\ubca4\ud2b8 \uc6d0\uc7a5\uc5d0 IP \uceec\ub7fc\uc744 \ub450\uc9c0 \uc54a\uace0 \ud0c0\uac9f\ud305\u00b7\uace0\uc720 \uc0ac\uc6a9\uc790\u00b7\ub2e4\uacc4\uc815 \ud310\ub2e8\uc5d0 \uc4f0\uc9c0 \uc54a\ub294\ub2e4. \uc778\ud504\ub77c \ub85c\uadf8\uc758 IP\ub294 \uc989\uc2dc \ub9c8\uc2a4\ud0b9\ud558\uac70\ub098 \uc9e7\uc740 \ubcf4\uc720 \ud6c4 \uc0ad\uc81c\ud558\uba70 \uc6d0\uc7a5\uacfc \uc870\uc778\ud558\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "docs_legal_privacy_design_ad_serve_log", "label": "ad_serve_log \uad11\uace0 \uacb0\uc815 \uc9d1\uacc4 \ub85c\uadf8 (CLAW-71)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ubc1c\uae09 \ub300\ube44 \ud45c\uc2dc \uc2dc\uc791\u00b7\uc720\ud6a8 \ub178\ucd9c \uc804\ud658\uc728\uc744 \uc138\uae30 \uc704\ud55c append-only \uc9d1\uacc4\ub2e4. userId\u00b7machineId\u00b7serveToken\u00b7IP\ub97c \uc800\uc7a5\ud558\uc9c0 \uc54a\uace0 impression_events\uc640 \uc870\uc778\ud558\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "docs_legal_privacy_design_delivery_email", "label": "\ucfe0\ud3f0 \ubc1c\uc1a1 \uc774\uba54\uc77c (CLAW-74)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uad50\ud658 1\uac74\uc758 \uc2a4\ub0c5\uc0f7\uc774\uba70 users.email\uc740 \uacc4\uc18d NULL\uc774\ub2e4 \u2014 \ub85c\uadf8\uc778 \uc2dd\ubcc4\uc790\uc640 \ubd84\ub9ac\ud558\uace0 \ub9e4 \uad50\ud658 \uc7ac\uc785\ub825\ubc1b\uc544 \ucd5c\uc18c\ud654\ud55c\ub2e4. \uc885\uacb0 \uc2dc \uc989\uc2dc NULL \ud30c\uae30\ud558\uace0 \ub3d9\uc758 \uc2dc\uac01\ub9cc \uc99d\uc801\uc73c\ub85c \ub0a8\uae34\ub2e4. \uc6d0\ubb38 \uc5f4\ub78c\uc740 \uac10\uc0ac\ub418\ub294 \ubcc4\ub3c4 \uc561\uc158\uc73c\ub85c\ub9cc \ud55c\ub2e4."}, {"id": "docs_legal_privacy_design_survey_responses", "label": "\ub9cc\uc871\ub3c4 \uc124\ubb38 \uc751\ub2f5 (CLAW-97)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ub9ac\uc6cc\ub4dc\ub97c 1\uc778 1\ud68c\ub85c \uc9c0\uae09\ud558\ub824\uba74 \uacc4\uc815\uacfc \uc5f0\uacb0\ud574\uc57c \ud574\uc11c \uc775\uba85 \uc751\ub2f5\uc774 \uc544\ub2c8\ub2e4 \u2014 \uadf8 \uc0ac\uc2e4\uc744 \uc124\ubb38 \ud654\uba74\uc5d0 \uace0\uc9c0\ud55c\ub2e4. \ud0c8\ud1f4\ub294 users \ud589\uc744 \uc9c0\uc6b0\uc9c0 \uc54a\uace0 \uac00\uba85\ud654\ud558\ubbc0\ub85c CASCADE\uc5d0 \uc758\uc874\ud558\uc9c0 \uc54a\uace0 \uba85\uc2dc\uc801\uc73c\ub85c \uc0ad\uc81c\ud55c\ub2e4."}, {"id": "docs_legal_privacy_design_user_reports", "label": "\uc774\uc6a9\uc790 \uc81c\ubcf4 (CLAW-234)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc790\uc720 \uc785\ub825\ub780\uc740 \ud504\ub86c\ud504\ud2b8\u00b7\uc18c\uc2a4\u00b7\uacbd\ub85c \uae08\uc9c0 \uacbd\uacc4\ub97c \uc6b0\ud68c\ud558\ub294 \ud1b5\ub85c\uac00 \ub418\uae30 \uc26c\uc6cc \uc785\ub825\ub780\uc5d0 \uc548\ub0b4\ub97c \ub454\ub2e4. \uc6f9\ud6c5 \uc54c\ub9bc\uc5d0\ub294 \ubcf8\ubb38 \uc804\uccb4\uc640 \uc774\uba54\uc77c\uc744 \uc2e3\uc9c0 \uc54a\uace0 \uc81c\ubcf4 ID\u00b7\uc2dc\uac01\u00b7\uc55e\ubd80\ubd84 \uc694\uc57d\ub9cc \ubcf4\ub0b8\ub2e4."}, {"id": "docs_legal_privacy_design_consent_separation", "label": "\ub3d9\uc758 \ubd84\ub9ac (\ud544\uc218\u00b7\uc120\ud0dd \ub3c5\ub9bd \uc800\uc7a5)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uac00\uc785 \ub3d9\uc758\ub97c \ud558\ub098\ub85c \ubb36\uc9c0 \uc54a\uace0 \uac01 \ub3d9\uc758\ub97c \ubc84\uc804\u00b7\uc2dc\uac01\uacfc \ud568\uaed8 \ub3c5\ub9bd \uc800\uc7a5\ud55c\ub2e4. \ud074\ub9ad \uc815\ubcf4\u00b7\uac1c\uc778\ud654 \uad11\uace0\ub294 \ubcc4\ub3c4 \uc120\ud0dd\uc774\uace0 \ubbfc\uac10\ud55c \uac1c\ubc1c \ub9e5\ub77d \ud65c\uc6a9\uc740 MVP \uae08\uc9c0\ub2e4."}, {"id": "docs_legal_privacy_design_monitoring_aggregates", "label": "\uc6b4\uc601 \ubaa8\ub2c8\ud130\ub9c1 \uc9d1\uacc4 (\u00a71.7, CLAW-65)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc0c8 \ud074\ub77c\uc774\uc5b8\ud2b8 \ud544\ub4dc\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\uace0 \uc774\ubbf8 \ucc98\ub9ac\ud55c \uc694\uccad\uacfc \uc6d0\uc7a5\uc5d0\uc11c \uc9d1\uacc4\uac12\ub9cc \uacc4\uc0b0\ud55c\ub2e4. \uba54\ud2b8\ub9ad label\uc5d0 \uc2dd\ubcc4\uc790\u00b7\uacbd\ub85c\u00b7\ud504\ub86c\ud504\ud2b8\u00b7\uc608\uc678 \uba54\uc2dc\uc9c0\ub97c \ub123\uc9c0 \uc54a\uace0 \ub3d9\uc801 \uacbd\ub85c\ub294 \uace0\uc815 route family\ub85c\ub9cc \ubd84\ub958\ud55c\ub2e4."}, {"id": "docs_legal_privacy_design_log_masking", "label": "\ub85c\uadf8 \ub9c8\uc2a4\ud0b9 (\u00a76.5)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc54c \uc218 \uc5c6\ub294 \uc11c\ubc84 \uc608\uc678\ub294 SQL\u00b7\ud30c\ub77c\ubbf8\ud130\u00b7stack\u00b7\uc694\uccad URL\uc744 \ub85c\uac70\uc5d0 \ub118\uae30\uc9c0 \uc54a\uace0 \uace0\uc815 \ucf54\ub4dc UNHANDLED_REQUEST_EXCEPTION\ub9cc \ub0a8\uae34\ub2e4."}, {"id": "docs_legal_privacy_design_user_rights", "label": "\uc774\uc6a9\uc790 \uad8c\ub9ac \uad6c\ud604 (\ub0b4\ubcf4\ub0b4\uae30\u00b7\ud0c8\ud1f4\u00b7\ud30c\uae30 \ub85c\uadf8)", "file_type": "concept", "source_file": "docs/legal/privacy-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "append-only \uc6d0\uc7a5\uc740 \uc0ad\uc81c\ud558\uc9c0 \uc54a