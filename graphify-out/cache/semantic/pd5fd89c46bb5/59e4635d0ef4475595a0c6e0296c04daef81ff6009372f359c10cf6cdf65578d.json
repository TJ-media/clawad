{"nodes": [{"id": "docs_design_overlay_contract_display_surface_unification", "label": "\ud45c\uc2dc \ucc3d\uad6c \uc77c\uc6d0\ud654 (\uc624\ubc84\ub808\uc774 \ub2e8\uc77c \ucc3d\uad6c, CLAW-134)", "file_type": "rationale", "source_file": "docs/design/overlay-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude Code\uc758 statusLine \uc2ac\ub86f\uc740 \ud558\ub098\ubfd0\uc774\ub77c clawad\uac00 \uc7a1\uace0 \uc788\uc73c\uba74 \uc624\ubc84\ub808\uc774\uac00 \uad6c\ub3c5 \ucffc\ud130(rate_limits)\ub97c \uc77d\uc744 \uc218 \uc5c6\uc5c8\ub2e4 \u2014 \uadf8 \uac12\uc740 statusline stdin\uc73c\ub85c\ub9cc \ub4e4\uc5b4\uc624\uace0, \uc0c1\ub958\uc758 \uccb4\uc774\ub2dd\uc740 \uc6d0\uaca9 \ubc30\ud3ec \uc804\uc6a9\uc774\ub77c \ub300\uc548\uc774 \ubabb \ub410\ub2e4. \uacb0\uacfc\ub85c \uc624\ubc84\ub808\uc774\uac00 \uc5c6\uc73c\uba74 \uad11\uace0\ub3c4 \uc801\ub9bd\ub3c4 \uc5c6\uace0, [\uad11\uace0] \ud45c\uae30 \uc758\ubb34\ub3c4 \uc624\ubc84\ub808\uc774\uac00 \uc9c4\ub2e4."}, {"id": "docs_design_overlay_contract_copyleft_isolation", "label": "AGPL \uce74\ud53c\ub808\ud504\ud2b8 \uaca9\ub9ac \uacbd\uacc4", "file_type": "rationale", "source_file": "docs/design/overlay-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "clawad-overlay\ub294 AGPL-3.0\uc774\ub77c \ucf54\ub4dc\ub97c \uacf5\uc720\ud558\uba74 \uce74\ud53c\ub808\ud504\ud2b8\uac00 \ube44\uacf5\uac1c \uc800\uc7a5\uc18c\ub85c \ubc88\uc9c4\ub2e4 \u2014 \ud1b5\uc2e0\uc740 \uc11c\ubc84 HTTP API\uc640 \ubb38\uc11c\ud654\ub41c \ub85c\uceec \ud30c\uc77c \ud611\uc57d\uc73c\ub85c\ub9cc \ud55c\ub2e4."}, {"id": "docs_design_overlay_contract_delegation_decision", "label": "client/*.js \uc7ac\uc0ac\uc6a9 = \uc704\uc784 \uacb0\uc815", "file_type": "rationale", "source_file": "docs/design/overlay-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud65c\ub3d9 \uac10\uc9c0\u00b7\uba38\uc2e0 ID\u00b7serveToken \uad00\ub9ac\u00b7\uc6d0\uc7a5 append\ub294 clawad\uc5d0 \ub0a8\uae34\ub2e4. AGPL\ub85c \uacf5\uac1c\ud558\uc9c0\ub3c4, \uad00\ucc30 \uc7ac\uad6c\ud604\ud558\uc9c0\ub3c4 \uc54a\ub294\ub2e4."}, {"id": "docs_design_overlay_contract_overlay_policy_cache", "label": "data/overlay-policy.json \uc815\ucc45 \uce90\uc2dc", "file_type": "concept", "source_file": "docs/design/overlay-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc624\ubc84\ub808\uc774\ub294 policy/ \ud30c\uc77c\uacfc loadPolicy()\uc5d0 \uc811\uadfc\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \ud45c\uc2dc\uc5d0 \ud544\uc694\ud55c \uac12\ub9cc sync\uac00 \ub118\uae34\ub2e4. \ub2e8\uac00\u00b7\ubc30\ubd84\uc728\u00b7\uc0c1\ud55c\u00b7CPM\uc740 \ub118\uae30\uc9c0 \uc54a\uace0, \uce90\uc2dc\uac00 \uc5c6\uc73c\uba74 \uae30\ubcf8\uac12\uc73c\ub85c \ub118\uaca8\uc9da\uc9c0 \uc54a\uace0 \uad11\uace0 \uae30\ub2a5\ub9cc \ub048\ub2e4."}, {"id": "docs_design_overlay_contract_ad_gap_ms", "label": "overlay.adGapMs \uc778\uc815 \uad6c\uac04 \uac04\uaca9", "file_type": "rationale", "source_file": "docs/design/overlay-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ub85c\ud14c\uc774\uc158\uc774 \ud45c\uc2dc \uad6c\uac04\uc744 0ms\ub85c \ubd99\uc774\uba74 \uc5f0\uc18d\uc73c\ub85c \ubcf8 \uad11\uace0\uac00 \uc11c\ub85c CONCURRENT_USER_IMPRESSION\uc73c\ub85c \uac78\ub9b0\ub2e4. \ud0a4\uac00 \uc5c6\uc73c\uba74 \uac04\uaca9 0\uc73c\ub85c \ub418\ub3cc\ub9ac\ub294\ub370, \uc774 \uac12\uc740 \uc2e0\uace0 \uad6c\uac04\uc744 \uc904\uc774\uae30\ub9cc \ud558\ubbc0\ub85c \uc815\ucc45\uac12 \ucd94\uce21\uc774 \uc544\ub2c8\ub2e4 \u2014 \uad11\uace0\ub97c \ub044\uba74 \uad6c CLI \uc0ac\uc6a9\uc790\uc758 \uc801\ub9bd\uc774 \uc601\uad6c\ud788 0\uc774 \ub41c\ub2e4. \uce90\uc2dc version\uc740 \uc62c\ub9ac\uc9c0 \uc54a\uc558\ub2e4(\uc62c\ub9ac\uba74 \uc0c8 CLI + \uad6c \uc624\ubc84\ub808\uc774 \uc870\ud569\uc5d0\uc11c \uac19\uc740 \ubb38\uc81c\uac00 \ubc29\ud5a5\ub9cc \ubc14\uafd4 \ub418\uc0b4\uc544\ub09c\ub2e4)."}, {"id": "docs_design_overlay_contract_stale_active_ms", "label": "activity.staleActiveMs (\uc880\ube44 \uc138\uc158 \ub9c8\uac10)", "file_type": "rationale", "source_file": "docs/design/overlay-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop \ud6c5\uc744 \ub193\uce5c \uc138\uc158\uc740 work-state\uc5d0 active: true\ub85c \uad73\ub294\ub2e4. \uc218\uac70\uc640 \uc624\ubc84\ub808\uc774\uac00 \uac19\uc740 \ub9c8\uac10 \uaddc\uce59\uc744 \uc4f0\uc9c0 \uc54a\uc73c\uba74 '\uc601\uc6d0\ud788 \uc791\uc5c5 \uc911'\uc73c\ub85c \uc624\ud310\ud574 \ubcf4\uc774\uc9c0\ub9cc \uc778\uc815\ub418\uc9c0 \uc54a\ub294 \ub178\ucd9c\ub9cc \uc313\uc774\uace0 \uc7ac\uace0\uac00 \ub9c8\ub978\ub2e4."}, {"id": "docs_design_overlay_contract_reward_summary_file", "label": "data/reward-summary.json (\ud45c\uc2dc \uc804\uc6a9 \uc218\uce58)", "file_type": "concept", "source_file": "docs/design/overlay-contract.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc11c\ubc84\uac00 \uc900 \uc218\uce58\ub97c \uadf8\ub300\ub85c \ud45c\uc2dc\ub9cc \ud55c\ub2e4 \u2014 '\ub178\ucd9c N\uac74 \u00d7 \ub2e8\uac00' \uac19\uc740 \uc2dd\uc744 \uc624\ubc84\ub808\uc774\uc5d0 \ub123\uc9c0 \uc54a\ub294\ub2e4. \ud45c\uc2dc \uc6a9\uc5b4\ub294 \uac80\uc99d \uc911\u00b7\ud655\uc815 \ub9ac\uc6cc\ub4dc\ub85c \uace0\uc815\ud558\uace0 '\uc801\ub9bd \uc608\uc815'\ucc98\ub7fc \ud655\uc815\uc744 \uc57d\uc18d\ud558\ub294 \ud45c\ud604\uc744 \uc4f0\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "docs_design_overlay_contract_ad_inventory_exhausted", "label": "data/ad-inventory.json exhausted \ud50c\ub798\uadf8", "file_type": "concept", "sou