{
	admin off
	auto_https off
}

:8080 {
	# frame-ancestors는 'none'이 아니라 'self'다 (CLAW-248). 마스코트는 <object>로 실린
	# SVG이고, 'none'이면 같은 출처인데도 임베드가 막혀 마스코트만 조용히 사라진다 —
	# 서버는 SVG에 200을 주므로 로그로는 안 보인다. 'self'도 교차 출처 프레이밍은 전부
	# 막으므로 클릭재킹 방어는 그대로다. 우리 출처가 우리 페이지를 프레임하는 것만 허용한다.
	header {
		X-Clawad-Release "{$RELEASE_SHA}"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'self'; form-action 'self'; connect-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@health path /healthz
	respond @health 200

	# 파일 경로를 URL에 드러내지 않는다. 정규 주소는 확장자 없는 /install·/survey이고,
	# 파일 이름으로 들어온 옛 링크는 그리로 돌린다(설치본이 안내하던 주소가 여기 있다).
	redir /index.html / permanent
	redir /install.html /install permanent
	redir /survey.html /survey permanent
	rewrite /install /install.html
	rewrite /survey /survey.html

	@versionedContent path / /install /survey /session-client.js /legal/*
	header @versionedContent Cache-Control "no-store"

	# 광고 신청 페이지 (CLAW-248). 정규 주소는 디렉터리라 확장자가 드러나지 않는다 —
	# file_server가 /creative → /creative/ 로 보내고 index.html을 낸다.
	@creativePage path /creative /creative/ /creative/index.html /creative/preview.js /creative/preview.css /creative/preview-model.js
	header @creativePage Cache-Control "no-store"

	# 에셋 캐시는 짧게 잡는다 (CLAW-248). 하루를 걸었더니 잘못된 CSP 헤더가 붙은 SVG가
	# 그대로 하루 동안 박혀, 서버를 고쳐도 이미 방문한 사람에게는 마스코트가 계속 안 떴다.
	# 트래픽이 적고 파일이 작아 5분 캐시로 잃는 것이 없다.
	@creativeAsset path /creative/assets/*
	header @creativeAsset Cache-Control "public, max-age=300"

	@staticAsset path /logo.png /mascot.svg /icons/*
	header @staticAsset Cache-Control "public, max-age=86400"

	root * /srv
	file_server
}
